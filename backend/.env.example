# Copy to backend/.env. Never commit .env.
# Required unless DEBUG=1. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=1
# Address the React app is served from (defaults to the Vite dev server).
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# S2: comma-separated emails of security-office admins.
ADMIN_EMAILS=guard@iitgn.ac.in
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Add http://localhost:5173 under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Development only: log in by typing an @iitgn.ac.in email, no Google needed. Ignored unless DEBUG=1.
DEV_LOGIN=0
# Shown to students next to found items that may match their lost report.
SECURITY_CONTACT=IITGN Security Office, Main Gate
# Email for sign-up and forgot-password codes. Leave EMAIL_HOST empty to print emails in the
# runserver terminal instead. For Gmail: smtp.gmail.com, port 587, and an App Password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IITGN Lost & Found <noreply@iitgn.ac.in>
